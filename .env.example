# Required — Supabase project credentials (Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Strongly recommended — protects /api/worker and /api/track from being used to
# hammer the California Lottery site. Send it as ?secret=... or x-worker-secret.
WORKER_SECRET=

# Optional tuning (defaults shown)
# COLLECTION_DRAWS=180
# FETCH_CONCURRENCY=6
# FETCH_TIMEOUT_MS=12000
# FETCH_ATTEMPTS=3
# WORKER_BUDGET_MS=50000
