  }
  const count = Math.max(2, Number(options.confidenceHistory || 12));
  const start = Math.max(0, draws.length - count);
  const history = [];
  for (let i = start; i < draws.length; i++) {
    history.push(liveConfidenceAtIndex(draws, ranked, options, target, i));
  }
  const current = history.at(-1);
  const previous = history.at(-2) || current;
  const delta = Number(current.score || 0) - Number(previous.score || 0);
  const trend = delta >= 6 ? 'RISING' : delta <= -6 ? 'FALLING' : 'STABLE';
  return {
    score: Number(current.score || 0),
    level: current.level || confidenceLevel(Number(current.score || 0)),
    trend,
    delta,
    hitNow: Boolean(current.hitNow),
    hitCount: Number(current.hitCount || 0),
    latestDrawId: current.drawId,
    latestTime: current.time,
    activeSignals: current.activeSignals || [],
    history: history.map(row => ({
      drawId: row.drawId,
      time: row.time,
      score: row.score,
      level: row.level,
      hitNow: row.hitNow,
      hitCount: row.hitCount
    }))
  };
}

function metricMap(segment) {
  return new Map((segment?.candidates || []).map(x => [tripleKey(x.numbers), x]));
}

function tierSignalScore(metric, signal, options) {
  if (!metric) return 0;
  const support = Number(metric.signalDraws || 0);
  const hits = Number(metric.signalThenHit || 0);
  const lift = Number(metric.forwardLift || 0);
  const coverage = Number(metric.precursorCoverage || 0);
  if (support < 3 || hits < 2 || lift <= 1) return 0;
  const age = Math.max(0, Number(signal.drawsAgo || 0));
  const recency = clamp((options.leadMax - age) / Math.max(1, options.leadMax), 0, 1);
  return Math.round(clamp(
    18 +
    clamp((lift - 1) * 24, 0, 32) +
    clamp(coverage * 55, 0, 14) +
    clamp(hits / 8, 0, 1) * 16 +
    clamp(support / 12, 0, 1) * 8 +
    recency * 12,
    0,
    100
  ));
}

function buildHitTierForecast(draws, ranked, options, target, tierMetrics) {
  const index = draws.length - 1;
  if (index < 0) return null;
  const currentHits = hitCount(draws[index], target);
  const signals = activeSignalsAtIndex(draws, ranked, options, index);
  const fourMap = metricMap(tierMetrics.validation4);
  const fiveMap = metricMap(tierMetrics.validation5);
  const discovery4Map = metricMap(tierMetrics.discovery4);
  const discovery5Map = metricMap(tierMetrics.discovery5);

  const tierSignals = signals.map(signal => {
    const key = tripleKey(signal.numbers);
    const v4 = fourMap.get(key) || null;
    const v5 = fiveMap.get(key) || null;
    const d4 = discovery4Map.get(key) || null;
    const d5 = discovery5Map.get(key) || null;
    const fourScore = tierSignalScore(v4, signal, options);
    const fiveRaw = tierSignalScore(v5, signal, options);
    const fiveEvidence = Number(v5?.signalThenHit || 0) >= 2 && Number(d5?.signalThenHit || 0) >= 2;
    const fiveScore = fiveEvidence ? fiveRaw : 0;
    return {
      numbers: signal.numbers,
      drawsAgo: signal.drawsAgo,
      fourPlusScore: fourScore,
      fiveScore,
      fourPlus: v4 ? {
        validationSignals: v4.signalDraws,
        validationHits: v4.signalThenHit,
        validationFailures: Math.max(0, Number(v4.signalDraws || 0) - Number(v4.signalThenHit || 0)),
        validationSuccessRate: round(safeRate(Number(v4.signalThenHit || 0), Number(v4.signalDraws || 0)), 4),
        validationLift: v4.forwardLift,
        validationCoverage: v4.precursorCoverage,
        discoveryHits: d4?.signalThenHit || 0
      } : null,
      five: v5 ? {
        validationSignals: v5.signalDraws,
        validationHits: v5.signalThenHit,
        validationLift: v5.forwardLift,
        validationCoverage: v5.precursorCoverage,
        discoveryHits: d5?.signalThenHit || 0
      } : null
    };
  }).sort((a, b) => b.fourPlusScore - a.fourPlusScore || b.fiveScore - a.fiveScore);
