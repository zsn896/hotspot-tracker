{
  "functions": {
    "api/worker.js": { "maxDuration": 60 },
    "api/track.js":  { "maxDuration": 60 },
    "api/state.js":  { "maxDuration": 30 },
    "api/group.js":  { "maxDuration": 10 },
    "api/health.js": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/worker", "schedule": "*/5 * * * *" }
  ]
}
